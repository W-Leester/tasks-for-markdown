{
  "name": "tasks-for-markdown",
  "displayName": "Tasks for Markdown",
  "description": "Obsidian Tasks-style task management for Markdown in VS Code and Cursor: queries, rendered view, kanban, calendar, recurrence and notes. Inspired by and compatible with the Obsidian Tasks plugin.",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#171d35",
    "theme": "dark"
  },
  "version": "1.0.0",
  "publisher": "hastycapybara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/W-Leester/tasks-for-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/W-Leester/tasks-for-markdown/issues"
  },
  "homepage": "https://github.com/W-Leester/tasks-for-markdown#readme",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "tasks",
    "todo",
    "obsidian",
    "obsidian-tasks",
    "checklist",
    "kanban",
    "calendar",
    "gtd",
    "productivity",
    "recurring",
    "dataview",
    "mcp"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/*.md"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "tasksmd.toggleDone",
        "title": "%tasksmd.toggleDone.title%",
        "category": "Tasks",
        "icon": "$(check)"
      },
      {
        "command": "tasksmd.openTask",
        "title": "%tasksmd.openTask.title%",
        "category": "Tasks",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tasksmd.openSidebar",
        "title": "%tasksmd.openSidebar.title%",
        "category": "Tasks"
      },
      {
        "command": "tasksmd.reindex",
        "title": "%tasksmd.reindex.title%",
        "category": "Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "tasksmd.showLogs",
        "title": "%tasksmd.showLogs.title%",
        "category": "Tasks"
      },
      {
        "command": "tasksmd.markDone",
        "title": "%tasksmd.markDone.title%",
        "category": "Tasks",
        "icon": "$(check)"
      },
      {
        "command": "tasksmd.markCancelled",
        "title": "%tasksmd.markCancelled.title%",
        "category": "Tasks",
        "icon": "$(circle-slash)"
      },
      {
        "command": "tasksmd.reopen",
