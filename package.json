{
  "name": "tasks-for-markdown",
  "displayName": "Tasks for Markdown",
  "description": "Obsidian Tasks-compatible task management for Markdown files in VS Code and Cursor.",
  "version": "0.0.1",
  "publisher": "HMCVECDT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/W-Leester/tasks-for-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/W-Leester/tasks-for-markdown/issues"
  },
  "homepage": "https://github.com/W-Leester/tasks-for-markdown#readme",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "tasks",
    "todo",
    "obsidian",
    "checklist"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/*.md"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "tasksmd.toggleDone",
        "title": "%tasksmd.toggleDone.title%",
        "category": "Tasks",
        "icon": "$(check)"
      },
      {
        "command": "tasksmd.openTask",
        "title": "%tasksmd.openTask.title%",
        "category": "Tasks",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tasksmd.openSidebar",
        "title": "%tasksmd.openSidebar.title%",
        "category": "Tasks"
      },
      {
        "command": "tasksmd.reindex",
        "title": "%tasksmd.reindex.title%",
        "category": "Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "tasksmd.showLogs",
        "title": "%tasksmd.showLogs.title%",
        "category": "Tasks"
      },
      {
        "command": "tasksmd.markDone",
        "title": "%tasksmd.markDone.title%",
        "category": "Tasks",
        "icon": "$(check)"
      },
      {
        "command": "tasksmd.markCancelled",
        "title": "%tasksmd.markCancelled.title%",
        "category": "Tasks",
        "icon": "$(circle-slash)"
      },
      {
        "command": "tasksmd.reopen",
        "title": "%tasksmd.reopen.title%",
        "category": "Tasks",
        "icon": "$(debug-restart)"
      },
      {
        "command": "tasksmd.tree.refresh",
        "title": "%tasksmd.tree.refresh.title%",
        "category": "Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "tasksmd.tree.groupBy",
        "title": "%tasksmd.tree.groupBy.title%",
        "category": "Tasks",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "tasksmd.tree.filter",
        "title": "%tasksmd.tree.filter.title%",
        "category": "Tasks",
        "icon": "$(filter)"
      },
      {
        "command": "tasksmd.tree.clearFilter",
        "title": "%tasksmd.tree.clearFilter.title%",
        "category": "Tasks",
        "icon": "$(filter-filled)"
      }
    ],
    "configuration": {
      "title": "Tasks for Markdown",
      "properties": {
        "tasksmd.taskFormat": {
          "type": "string",
          "enum": [
            "emoji",
            "dataview"
          ],
          "default": "emoji",
          "enumDescriptions": [
            "%tasksmd.config.taskFormat.emoji%",
            "%tasksmd.config.taskFormat.dataview%"
          ],
          "description": "%tasksmd.config.taskFormat%"
        },
        "tasksmd.globalFilter": {
          "type": "string",
          "default": "",
          "description": "%tasksmd.config.globalFilter%"
        },
        "tasksmd.removeGlobalFilterFromDescription": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.removeGlobalFilterFromDescription%"
        },
        "tasksmd.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.md",
            "**/*.markdown"
          ],
          "description": "%tasksmd.config.include%"
        },
        "tasksmd.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**"
          ],
          "description": "%tasksmd.config.exclude%"
        },
        "tasksmd.respectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.respectGitignore%"
        },
        "tasksmd.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "description": "%tasksmd.config.maxFileSizeKB%"
        },
        "tasksmd.setCreatedDate": {
          "type": "boolean",
          "default": false,
          "description": "%tasksmd.config.setCreatedDate%"
        },
        "tasksmd.setDoneDate": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.setDoneDate%"
        },
        "tasksmd.setCancelledDate": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.setCancelledDate%"
        }
      }
    },
    "keybindings": [
      {
        "command": "tasksmd.toggleDone",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == markdown && tasksmd.onTaskLine"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tasksmd.openTask",
          "when": "false"
        },
        {
          "command": "tasksmd.tree.refresh",
          "when": "false"
        },
        {
          "command": "tasksmd.tree.clearFilter",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "tasksmd.editorContext",
          "group": "tasksmd@1",
          "when": "editorLangId == markdown && tasksmd.onTaskLine"
        }
      ],
      "tasksmd.editorContext": [
        {
          "command": "tasksmd.toggleDone",
          "group": "1_edit@1"
        },
        {
          "command": "tasksmd.markDone",
          "group": "1_edit@2"
        },
        {
          "command": "tasksmd.markCancelled",
          "group": "1_edit@3"
        }
      ],
      "view/title": [
        {
          "command": "tasksmd.tree.filter",
          "when": "view == tasksmd.tasks && !tasksmd.tree.filterActive",
          "group": "navigation@1"
        },
        {
          "command": "tasksmd.tree.clearFilter",
          "when": "view == tasksmd.tasks && tasksmd.tree.filterActive",
          "group": "navigation@1"
        },
        {
          "command": "tasksmd.tree.groupBy",
          "when": "view == tasksmd.tasks",
          "group": "navigation@2"
        },
        {
          "command": "tasksmd.tree.refresh",
          "when": "view == tasksmd.tasks",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "tasksmd.openTask",
          "when": "view == tasksmd.tasks && viewItem =~ /^task/",
          "group": "inline@1"
        },
        {
          "command": "tasksmd.markDone",
          "when": "view == tasksmd.tasks && viewItem == task",
          "group": "1_status@1"
        },
        {
          "command": "tasksmd.markCancelled",
          "when": "view == tasksmd.tasks && viewItem == task",
          "group": "1_status@2"
        },
        {
          "command": "tasksmd.reopen",
          "when": "view == tasksmd.tasks && viewItem == task.completed",
          "group": "1_status@1"
        },
        {
          "command": "tasksmd.openTask",
          "when": "view == tasksmd.tasks && viewItem =~ /^task/",
          "group": "2_nav@1"
        }
      ]
    },
    "submenus": [
      {
        "id": "tasksmd.editorContext",
        "label": "Tasks"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tasksmd",
          "title": "Tasks",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "tasksmd": [
        {
          "id": "tasksmd.tasks",
          "name": "%tasksmd.view.tasks%",
          "icon": "$(checklist)",
          "contextualTitle": "Tasks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tasksmd.tasks",
        "contents": "%tasksmd.view.tasks.welcome%",
        "when": "tasksmd.indexEmpty"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "package": "pnpm build && vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "vscode:prepublish": "pnpm build",
    "test:integration": "node -e \"require('fs').rmSync('dist/tests',{recursive:true,force:true})\" && tsc -p tsconfig.integration.json && vscode-test",
    "test:all": "pnpm test && pnpm build && pnpm test:integration"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "ignore": "^7.0.9"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.2",
    "ovsx": "^0.10.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
