    "configuration": {
      "title": "Tasks for Markdown",
      "properties": {
        "tasksmd.taskFormat": {
          "type": "string",
          "enum": [
            "emoji",
            "dataview"
          ],
          "default": "emoji",
          "enumDescriptions": [
            "%tasksmd.config.taskFormat.emoji%",
            "%tasksmd.config.taskFormat.dataview%"
          ],
          "description": "%tasksmd.config.taskFormat%"
        },
        "tasksmd.globalFilter": {
          "type": "string",
          "default": "",
          "description": "%tasksmd.config.globalFilter%"
        },
        "tasksmd.removeGlobalFilterFromDescription": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.removeGlobalFilterFromDescription%"
        },
        "tasksmd.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.md",
            "**/*.markdown"
          ],
          "description": "%tasksmd.config.include%"
        },
        "tasksmd.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**"
          ],
          "description": "%tasksmd.config.exclude%"
        },
        "tasksmd.respectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.respectGitignore%"
        },
        "tasksmd.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "description": "%tasksmd.config.maxFileSizeKB%"
        },
        "tasksmd.setCreatedDate": {
          "type": "boolean",
          "default": false,
          "description": "%tasksmd.config.setCreatedDate%"
        },
        "tasksmd.setDoneDate": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.setDoneDate%"
        },
        "tasksmd.requireDueDate": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.requireDueDate%"
        },
        "tasksmd.setCancelledDate": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.setCancelledDate%"
        },
        "tasksmd.decorations.relativeDates": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.decorations.relativeDates%"
        },
        "tasksmd.decorations.overdueHighlight": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.decorations.overdueHighlight%"
        },
        "tasksmd.decorations.strikeDone": {
          "type": "boolean",
          "default": false,
          "description": "%tasksmd.config.decorations.strikeDone%"
        },
        "tasksmd.decorations.strikeCancelled": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.decorations.strikeCancelled%"
        },
        "tasksmd.decorations.dimFields": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.decorations.dimFields%"
        },
        "tasksmd.decorations.gutterIcons": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.decorations.gutterIcons%"
        },
        "tasksmd.codeLens.mode": {
          "type": "string",
          "enum": [
            "off",
            "cursorLine",
            "all"
          ],
          "default": "cursorLine",
          "enumDescriptions": [
            "%tasksmd.config.codeLens.mode.off%",
            "%tasksmd.config.codeLens.mode.cursorLine%",
            "%tasksmd.config.codeLens.mode.all%"
          ],
          "description": "%tasksmd.config.codeLens.mode%"
        },
        "tasksmd.autoSuggest.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.autoSuggest.enabled%"
        },
        "tasksmd.autoSuggest.minMatch": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 3,
          "description": "%tasksmd.config.autoSuggest.minMatch%"
        },
        "tasksmd.autoSuggest.maxItems": {
          "type": "number",
          "default": 8,
          "minimum": 3,
          "maximum": 20,
          "description": "%tasksmd.config.autoSuggest.maxItems%"
        },
        "tasksmd.recurrence.insertPosition": {
          "type": "string",
          "enum": [
            "above",
            "below"
          ],
          "default": "above",
          "description": "%tasksmd.config.recurrence.insertPosition%"
        },
        "tasksmd.recurrence.idHandling": {
          "type": "string",
          "enum": [
            "keep",
            "new",
            "remove"
          ],
          "default": "keep",
          "enumDescriptions": [
            "%tasksmd.config.recurrence.idHandling.keep%",
            "%tasksmd.config.recurrence.idHandling.new%",
            "%tasksmd.config.recurrence.idHandling.remove%"
          ],
          "description": "%tasksmd.config.recurrence.idHandling%"
        },
        "tasksmd.recurrence.copyDependsOn": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.recurrence.copyDependsOn%"
        },
        "tasksmd.recurrence.removeScheduledDate": {
          "type": "boolean",
          "default": false,
          "description": "%tasksmd.config.recurrence.removeScheduledDate%"
        },
        "tasksmd.statuses": {
          "type": "array",
          "default": [
            {
              "symbol": " ",
              "name": "Todo",
              "nextSymbol": "x",
              "type": "TODO"
            },
            {
              "symbol": "x",
              "name": "Done",
              "nextSymbol": " ",
              "type": "DONE"
            },
            {
              "symbol": "/",
              "name": "In Progress",
              "nextSymbol": "x",
              "type": "IN_PROGRESS"
            },
            {
              "symbol": "-",
              "name": "Cancelled",
              "nextSymbol": " ",
              "type": "CANCELLED"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "symbol",
              "name",
              "nextSymbol",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1,
                "description": "%tasksmd.config.statuses.symbol%"
              },
              "name": {
                "type": "string",
                "description": "%tasksmd.config.statuses.name%"
              },
              "nextSymbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1,
                "description": "%tasksmd.config.statuses.nextSymbol%"
              },
              "type": {
                "type": "string",
                "enum": [
                  "TODO",
                  "IN_PROGRESS",
                  "ON_HOLD",
                  "DONE",
                  "CANCELLED",
                  "NON_TASK"
                ],
                "description": "%tasksmd.config.statuses.type%"
              }
            }
          },
          "markdownDescription": "%tasksmd.config.statuses%"
        },
        "tasksmd.query.allowFunctions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%tasksmd.config.query.allowFunctions%"
        },
        "tasksmd.query.showTree": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.query.showTree%"
        },
        "tasksmd.savedQueries": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name",
              "query"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "query": {
                "type": "string",
                "description": "%tasksmd.config.savedQueries.query%"
              }
            }
          },
          "markdownDescription": "%tasksmd.config.savedQueries%"
        },
        "tasksmd.preview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.preview.enabled%"
        },
        "tasksmd.preview.renderBadges": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.preview.renderBadges%"
        },
        "tasksmd.editModal.accessKeys": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.editModal.accessKeys%"
        },
        "tasksmd.editModal.hiddenFields": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "enum": [
              "priority",
              "recurrence",
              "start",
              "scheduled",
              "due",
              "otherDates",
              "status",
              "dependencies",
              "onCompletion",
              "notes"
            ]
          },
          "description": "%tasksmd.config.editModal.hiddenFields%"
        },
        "tasksmd.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.notifications.enabled%"
        },
        "tasksmd.notifications.os": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.notifications.os%"
        },
        "tasksmd.notifications.dailyTime": {
          "type": "string",
          "default": "09:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "%tasksmd.config.notifications.dailyTime%"
        },
        "tasksmd.notifications.dueWithinDays": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 30,
          "description": "%tasksmd.config.notifications.dueWithinDays%"
        },
        "tasksmd.archive.file": {
          "type": "string",
          "default": "Archive.md",
          "description": "%tasksmd.config.archive.file%"
        },
        "tasksmd.archive.afterDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "%tasksmd.config.archive.afterDays%"
        },
        "tasksmd.archive.linkStyle": {
          "type": "string",
          "enum": [
            "wiki",
            "markdown"
          ],
          "default": "wiki",
          "description": "%tasksmd.config.archive.linkStyle%"
        },
        "tasksmd.calendar.newTaskFile": {
          "type": "string",
          "default": "",
          "description": "%tasksmd.config.calendar.newTaskFile%"
        },
        "tasksmd.calendar.fullScreen": {
          "type": "string",
          "enum": [
            "maximize",
            "window"
          ],
          "enumDescriptions": [
            "%tasksmd.config.calendar.fullScreen.maximize%",
            "%tasksmd.config.calendar.fullScreen.window%"
          ],
          "default": "maximize",
          "description": "%tasksmd.config.calendar.fullScreen%"
        },
        "tasksmd.rendered.fieldStyle": {
          "type": "string",
          "enum": [
            "plain",
            "badges"
          ],
          "enumDescriptions": [
            "%tasksmd.config.rendered.fieldStyle.plain%",
            "%tasksmd.config.rendered.fieldStyle.badges%"
          ],
          "default": "plain",
          "description": "%tasksmd.config.rendered.fieldStyle%"
        },
        "tasksmd.rendered.fontSize": {
          "type": "number",
          "minimum": 10,
          "maximum": 24,
          "default": 14.5,
          "description": "%tasksmd.config.rendered.fontSize%"
        },
        "tasksmd.rendered.lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 2.5,
          "default": 1.6,
          "description": "%tasksmd.config.rendered.lineHeight%"
        },
        "tasksmd.rendered.fieldsAlign": {
          "type": "string",
          "enum": [
            "columns",
            "right",
            "inline"
          ],
          "enumDescriptions": [
            "%tasksmd.config.rendered.fieldsAlign.columns%",
            "%tasksmd.config.rendered.fieldsAlign.right%",
            "%tasksmd.config.rendered.fieldsAlign.inline%"
          ],
          "default": "columns",
          "description": "%tasksmd.config.rendered.fieldsAlign%"
        },
        "tasksmd.rendered.sourceWhenNoTasks": {
          "type": "boolean",
          "default": true,
          "description": "%tasksmd.config.rendered.sourceWhenNoTasks%"
        },
        "tasksmd.rendered.maxWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 4000,
          "default": 0,
          "description": "%tasksmd.config.rendered.maxWidth%"
        },
        "tasksmd.calendar.fontSize": {
          "type": "number",
          "minimum": 9,
          "maximum": 24,
          "default": 13,
          "description": "%tasksmd.config.calendar.fontSize%"
        },
        "tasksmd.updateCheckUrl": {
          "type": "string",
          "default": "",
          "description": "%tasksmd.config.updateCheckUrl%"
        },
        "tasksmd.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ko"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%tasksmd.config.language.auto%",
            "English",
            "한국어"
          ],
          "description": "%tasksmd.config.language%"
        },
        "tasksmd.api.writePolicy": {
          "type": "string",
          "enum": [
            "confirm",
            "allow",
            "deny"
          ],
          "enumDescriptions": [
            "%tasksmd.config.api.writePolicy.confirm%",
            "%tasksmd.config.api.writePolicy.allow%",
            "%tasksmd.config.api.writePolicy.deny%"
          ],
          "default": "confirm",
          "description": "%tasksmd.config.api.writePolicy%"
        },
        "tasksmd.api.allowedWriters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%tasksmd.config.api.allowedWriters%"
        },
        "tasksmd.api.batchLimit": {
          "type": "number",
          "minimum": 1,
          "maximum": 5000,
          "default": 200,
          "description": "%tasksmd.config.api.batchLimit%"
        }
      }
    },
    "keybindings": [
      {
        "command": "tasksmd.toggleDone",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == markdown && tasksmd.onTaskLine"
      },
      {
        "command": "tasksmd.createOrEdit",
        "key": "ctrl+shift+c",
        "mac": "ctrl+shift+c",
        "when": "!terminalFocus && (editorTextFocus || !inputFocus)"
      },
      {
        "command": "tasksmd.quickSearch",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      },
      {
        "command": "tasksmd.openRendered",
        "key": "ctrl+shift+r",
        "mac": "ctrl+shift+r",
        "when": "!terminalFocus && (editorTextFocus && editorLangId == markdown || activeCustomEditorId == tasksmd.rendered || !inputFocus && resourceExtname =~ /\\.(md|markdown)$/)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tasksmd.openTask",
          "when": "false"
        },
        {
          "command": "tasksmd.tree.refresh",
          "when": "false"
        },
        {
          "command": "tasksmd.tree.clearFilter",
          "when": "false"
        },
        {
          "command": "tasksmd.savedQuery.edit",
          "when": "false"
        },
        {
          "command": "tasksmd.savedQuery.delete",
          "when": "false"
        },
        {
          "command": "tasksmd.savedQuery.explain",
          "when": "false"
        },
        {
          "command": "tasksmd.savedQuery.refresh",
          "when": "false"
        },
        {
          "command": "tasksmd.savedQuery.openInBuilder",
          "when": "false"
        },
        {
          "command": "tasksmd.openSource",
          "when": "activeCustomEditorId == tasksmd.rendered"
        },
        {
          "command": "tasksmd.api.query.run",
          "when": "false"
        },
        {
          "command": "tasksmd.api.query.explain",
          "when": "false"
        },
        {
          "command": "tasksmd.api.query.get",
          "when": "false"
        },
        {
          "command": "tasksmd.api.query.list",
          "when": "false"
        },
        {
          "command": "tasksmd.api.query.saved",
          "when": "false"
        },
        {
          "command": "tasksmd.api.edit.create",
          "when": "false"
        },
        {
          "command": "tasksmd.api.edit.update",
          "when": "false"
        },
        {
          "command": "tasksmd.api.edit.setStatus",
          "when": "false"
        },
        {
          "command": "tasksmd.api.edit.toggle",
          "when": "false"
        },
        {
          "command": "tasksmd.api.edit.postpone",
          "when": "false"
        },
        {
          "command": "tasksmd.api.edit.remove",
          "when": "false"
        },
        {
          "command": "tasksmd.api.edit.addNote",
          "when": "false"
        },
        {
          "command": "tasksmd.api.info",
          "when": "false"
        },
        {
          "command": "tasksmd.api.edit.batch",
          "when": "false"
        },
        {
          "command": "tasksmd.api.ui.openEdit",
          "when": "false"
        },
        {
          "command": "tasksmd.api.ui.openKanban",
          "when": "false"
        },
        {
          "command": "tasksmd.api.ui.openCalendar",
          "when": "false"
        },
        {
          "command": "tasksmd.api.ui.openQueryResults",
          "when": "false"
        },
        {
          "command": "tasksmd.api.ui.reveal",
          "when": "false"
        },
        {
          "command": "tasksmd.previewRender",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "tasksmd.editorContext",
          "group": "tasksmd@1",
          "when": "editorLangId == markdown && tasksmd.onTaskLine"
        }
      ],
      "tasksmd.editorContext": [
        {
          "command": "tasksmd.toggleDone",
          "group": "1_edit@1"
        },
        {
          "command": "tasksmd.markDone",
          "group": "1_edit@2"
        },
        {
          "command": "tasksmd.markCancelled",
          "group": "1_edit@3"
        },
        {
          "command": "tasksmd.createOrEdit",
          "group": "0_edit@1"
        },
        {
          "command": "tasksmd.setStatus",
          "group": "2_fields@1"
        },
        {
          "command": "tasksmd.setPriority",
          "group": "2_fields@2"
        },
        {
          "command": "tasksmd.setDueDate",
          "group": "2_fields@3"
        },
        {
          "command": "tasksmd.setScheduledDate",
          "group": "2_fields@4"
        },
        {
          "command": "tasksmd.setStartDate",
          "group": "2_fields@5"
        },
        {
          "command": "tasksmd.postpone",
          "group": "2_fields@6"
        },
        {
          "command": "tasksmd.setDependencies",
          "group": "2_fields@7"
        },
        {
          "command": "tasksmd.setRecurrence",
          "group": "2_fields@8"
        },
        {
          "command": "tasksmd.convertFormat",
          "group": "9_file@1"
        }
      ],
      "view/title": [
        {
          "command": "tasksmd.quickSearch",
          "when": "view == tasksmd.tasks",
          "group": "navigation@0"
        },
        {
          "command": "tasksmd.tree.filter",
          "when": "view == tasksmd.tasks && !tasksmd.tree.filterActive",
          "group": "navigation@1"
        },
        {
          "command": "tasksmd.tree.clearFilter",
          "when": "view == tasksmd.tasks && tasksmd.tree.filterActive",
          "group": "navigation@1"
        },
        {
          "command": "tasksmd.tree.groupBy",
          "when": "view == tasksmd.tasks",
          "group": "navigation@2"
        },
        {
          "command": "tasksmd.tree.refresh",
          "when": "view == tasksmd.tasks",
          "group": "navigation@3"
        },
        {
          "command": "tasksmd.savedQuery.new",
          "when": "view == tasksmd.savedQueries",
          "group": "navigation@1"
        },
        {
          "command": "tasksmd.savedQuery.refresh",
          "when": "view == tasksmd.savedQueries",
          "group": "navigation@2"
        },
        {
          "command": "tasksmd.openKanban",
          "when": "view == tasksmd.kanban",
          "group": "navigation@1"
        },
        {
          "command": "tasksmd.openQueryBuilder",
          "when": "view == tasksmd.savedQueries",
          "group": "navigation@0"
        },
        {
          "command": "tasksmd.openCalendar",
          "when": "view == tasksmd.tasks",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "tasksmd.openTask",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem =~ /^task/",
          "group": "inline@1"
        },
        {
          "command": "tasksmd.markDone",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem == task",
          "group": "1_status@1"
        },
        {
          "command": "tasksmd.markCancelled",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem == task",
          "group": "1_status@2"
        },
        {
          "command": "tasksmd.reopen",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem == task.completed",
          "group": "1_status@1"
        },
        {
          "command": "tasksmd.openTask",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem =~ /^task/",
          "group": "2_nav@1"
        },
        {
          "command": "tasksmd.createOrEdit",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem =~ /^task/",
          "group": "0_edit@1"
        },
        {
          "command": "tasksmd.setPriority",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem =~ /^task/",
          "group": "3_fields@1"
        },
        {
          "command": "tasksmd.setDueDate",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem =~ /^task/",
          "group": "3_fields@2"
        },
        {
          "command": "tasksmd.setScheduledDate",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem =~ /^task/",
          "group": "3_fields@3"
        },
        {
          "command": "tasksmd.postpone",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem == task",
          "group": "3_fields@4"
        },
        {
          "command": "tasksmd.setStatus",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem =~ /^task/",
          "group": "3_fields@5"
        },
        {
          "command": "tasksmd.setDependencies",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem =~ /^task/",
          "group": "3_fields@6"
        },
        {
          "command": "tasksmd.setRecurrence",
          "when": "(view == tasksmd.tasks || view == tasksmd.savedQueries) && viewItem =~ /^task/",
          "group": "3_fields@7"
        },
        {
          "command": "tasksmd.savedQuery.edit",
          "when": "view == tasksmd.savedQueries && viewItem =~ /^savedQuery/",
          "group": "inline@1"
        },
        {
          "command": "tasksmd.savedQuery.explain",
          "when": "view == tasksmd.savedQueries && viewItem =~ /^savedQuery/",
          "group": "1_q@1"
        },
        {
          "command": "tasksmd.savedQuery.edit",
          "when": "view == tasksmd.savedQueries && viewItem =~ /^savedQuery/",
          "group": "1_q@2"
        },
        {
          "command": "tasksmd.savedQuery.delete",
          "when": "view == tasksmd.savedQueries && viewItem =~ /^savedQuery/",
          "group": "1_q@3"
        },
        {
          "command": "tasksmd.savedQuery.openInBuilder",
          "when": "view == tasksmd.savedQueries && viewItem =~ /^savedQuery/",
          "group": "1_q@0"
        }
      ],
      "editor/title": [
        {
          "command": "tasksmd.previewRender",
          "when": "resourceExtname =~ /\\.(md|markdown)$/ && activeCustomEditorId != tasksmd.rendered",
          "group": "navigation@-10"
        },
        {
          "command": "tasksmd.openSource",
          "when": "activeCustomEditorId == tasksmd.rendered",
          "group": "navigation@9"
        }
      ]
    },
    "submenus": [
      {
        "id": "tasksmd.editorContext",
        "label": "Tasks"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tasksmd",
          "title": "Tasks",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "tasksmd": [
        {
          "id": "tasksmd.tasks",
          "name": "%tasksmd.view.tasks%",
          "icon": "$(checklist)",
          "contextualTitle": "Tasks"
        },
        {
          "id": "tasksmd.savedQueries",
          "name": "%tasksmd.view.savedQueries%",
          "icon": "$(search)",
          "contextualTitle": "Saved queries"
        },
        {
          "id": "tasksmd.kanban",
          "type": "webview",
          "name": "%tasksmd.view.kanban%",
          "icon": "$(project)",
          "contextualTitle": "Kanban",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tasksmd.tasks",
        "contents": "%tasksmd.view.tasks.welcome%",
        "when": "tasksmd.indexEmpty"
      },
      {
        "view": "tasksmd.savedQueries",
        "contents": "%tasksmd.view.savedQueries.welcome%",
        "when": "tasksmd.savedQueriesEmpty"
      }
    ],
    "customEditors": [
      {
        "viewType": "tasksmd.rendered",
        "displayName": "%tasksmd.rendered.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "colors": [
      {
        "id": "tasksmd.overdueBackground",
        "description": "%tasksmd.color.overdueBackground%",
        "defaults": {
          "dark": "#f1454533",
          "light": "#f1454522",
          "highContrast": "#f1454566",
          "highContrastLight": "#f1454566"
        }
      },
      {
        "id": "tasksmd.dueTodayBackground",
        "description": "%tasksmd.color.dueTodayBackground%",
        "defaults": {
          "dark": "#d9a30033",
          "light": "#d9a30022",
          "highContrast": "#d9a30066",
          "highContrastLight": "#d9a30066"
        }
      },
      {
        "id": "tasksmd.fieldForeground",
        "description": "%tasksmd.color.fieldForeground%",
        "defaults": {
          "dark": "#9d9d9d",
          "light": "#6e6e6e",
          "highContrast": "#bbbbbb",
          "highContrastLight": "#444444"
        }
      },
      {
        "id": "tasksmd.hintForeground",
        "description": "%tasksmd.color.hintForeground%",
        "defaults": {
          "dark": "#8b8b8b",
          "light": "#7a7a7a",
          "highContrast": "#cccccc",
          "highContrastLight": "#333333"
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.api.json && tsc --noEmit -p packages/cli/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests packages/cli/src",
    "format": "prettier --write .",
    "package": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm build:prod && pnpm build:api-types && vsce package --no-dependencies && node scripts/make-latest.mjs",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "vscode:prepublish": "pnpm build",
    "test:integration": "pnpm build && node -e \"require('fs').rmSync('dist/tests',{recursive:true,force:true})\" && tsc -p tsconfig.integration.json && vscode-test",
    "test:all": "pnpm test && pnpm test:integration",
    "build:prod": "node esbuild.config.mjs --production",
    "test:webviews": "vitest run --config vitest.webviews.config.mts",
    "build:api-types": "tsc -p tsconfig.api.json",
    "build:packages": "pnpm --filter @hastycapybara/tasks-core build && pnpm --filter @hastycapybara/tasks-cli build && pnpm --filter @hastycapybara/tasks-api build"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "ignore": "^7.0.9",
    "markdown-it": "^15.0.2",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^9.0.0",
    "glob": "^13.0.6",
    "jsdom": "^30.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mocha": "^12.0.2",
    "ovsx": "^0.10.0",
    "prettier": "^3.3.0",
    "svelte": "^5.57.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0",
    "zod": "4.6.5"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%tasksmd.capabilities.untrusted%",
      "restrictedConfigurations": [
        "tasksmd.query.allowFunctions",
        "tasksmd.notifications.os",
        "tasksmd.updateCheckUrl"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "%tasksmd.capabilities.virtual%"
    }
  },
  "types": "./dist/api-types/api/types.d.ts"
}
